<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="18dp"
    android:background="@drawable/bg_demo_hero"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/demoHeroBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_demo_chip"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:textColor="@color/demo_hero_text"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/demoHeroTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:textColor="@color/demo_hero_text"
        android:textSize="29sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/demoHeroDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/demo_hero_text_secondary"
        android:textSize="15sp" />
</LinearLayout>
